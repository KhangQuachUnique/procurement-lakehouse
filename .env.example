APP_ENV=dev
LOG_LEVEL=INFO

MUASAMCONG_BASE_URL=https://muasamcong.mpi.gov.vn
MUASAMCONG_TIMEOUT_SECONDS=30
MUASAMCONG_MAX_ATTEMPTS=3
MUASAMCONG_MAX_RETRY_DELAY_SECONDS=30
MUASAMCONG_MAX_INFLIGHT=3
KHLCNT_PACKAGE_WORKERS=3
INGESTION_RESOURCE_WORKERS=2
OPS_INDEX_PATH=./data/ops/index.sqlite3
OPS_SYNC_INTERVAL_SECONDS=5
OPS_RECONCILE_INTERVAL_SECONDS=300
OPS_SYNC_WORKERS=8
OPS_STALE_AFTER_SECONDS=600
# Optional local workspace; keep it outside source and allocate disk space for DLT state.
# DLT_PIPELINES_DIR=./data/dlt-pipelines
# INGESTION_LOCK_DIR=./data/locks

# =========================
# Object Storage - SeaweedFS
# =========================
OBJECT_STORAGE_IMAGE=chrislusf/seaweedfs:4.46

OBJECT_STORAGE_ENDPOINT=http://localhost:8333

OBJECT_STORAGE_ACCESS_KEY=procurement_admin
OBJECT_STORAGE_SECRET_KEY=change_this_to_a_long_random_password

OBJECT_STORAGE_BUCKET=procurement-lakehouse
OBJECT_STORAGE_API_PORT=8333

MUASAMCONG_TOKEN=fake_token
