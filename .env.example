# ==============================================================================
# PROCUREMENT LAKEHOUSE - ENVIRONMENT TEMPLATE
# Copy to `.env` and fill in MUASAMCONG_TOKEN (and change passwords for prod).
# ==============================================================================

# 1. Runtime & Source API (muasamcong.mof.gov.vn)
APP_ENV=dev
LOG_LEVEL=INFO
MUASAMCONG_BASE_URL=https://muasamcong.mof.gov.vn
MUASAMCONG_TOKEN=replace_with_your_token
DAGSTER_BRONZE_START_DATE=2022-01-01

# 2. PostgreSQL (Consolidated single instance: `procurement` + `dagster` DBs)
APP_POSTGRES_USER=procurement
APP_POSTGRES_PASSWORD=password
APP_POSTGRES_DB=procurement
APP_POSTGRES_PORT=25432
DAGSTER_POSTGRES_PASSWORD=dagster
APP_DATABASE_URL=postgresql+psycopg://procurement:password@127.0.0.1:25432/procurement

# 3. Object Storage & Iceberg REST Catalog (SeaweedFS)
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:8333
OBJECT_STORAGE_ACCESS_KEY=procurement_admin
OBJECT_STORAGE_SECRET_KEY=change_this_to_a_long_random_password
OBJECT_STORAGE_BUCKET=procurement-lakehouse
ICEBERG_CATALOG_URI=http://127.0.0.1:8181
ICEBERG_WAREHOUSE=s3://warehouse
# Uncomment to expose SeaweedFS S3, Iceberg REST & Spark Master to other PCs on LAN (default: 127.0.0.1)
# OBJECT_STORAGE_BIND_ADDRESS=0.0.0.0
# ICEBERG_CATALOG_BIND_ADDRESS=0.0.0.0
# SPARK_MASTER_BIND_ADDRESS=0.0.0.0

# 4. Medallion Namespaces
SILVER_TARGET_NAMESPACE=silver
SILVER_RELEASE_NAMESPACE=silver
GOLD_TARGET_NAMESPACE=gold
GOLD_RELEASE_NAMESPACE=gold

# 5. Apache Spark 4.0 Silver Engine
# - Single machine (fastest & lowest RAM): SPARK_MASTER=local[6]
# - Multi-node K3s cluster: SPARK_MASTER=spark://spark-master.procurement.svc.cluster.local:7077
SPARK_SILVER_NAMESPACE=silver_spark
SPARK_MASTER=local[6]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=6
SPARK_SHUFFLE_PARTITIONS=24
# Set true inside Docker/K3s (uses JARs pre-baked in /opt/spark/jars/, 0s Maven download)
SPARK_USE_BUNDLED_JARS=false
# Optional: override SSD scratch dir (default: /var/tmp/spark-scratch on Linux, %TEMP%/spark-scratch on Windows)
# SPARK_LOCAL_DIR=/var/tmp/spark-scratch
