# Custom Apache Spark 4.0 image with Iceberg 1.10 + S3A JARs pre-baked into /opt/spark/jars/
# Eliminates Maven/Ivy downloads on container/pod startup (100% offline-ready).
FROM apache/spark:4.0.0-python3

USER root
ARG MAVEN=https://repo1.maven.org/maven2
RUN mkdir -p /var/tmp/spark-scratch && chown -R spark:spark /var/tmp/spark-scratch \
    && curl -fsSL -o /opt/spark/jars/iceberg-spark-runtime-4.0_2.13-1.10.0.jar \
        ${MAVEN}/org/apache/iceberg/iceberg-spark-runtime-4.0_2.13/1.10.0/iceberg-spark-runtime-4.0_2.13-1.10.0.jar \
    && curl -fsSL -o /opt/spark/jars/iceberg-aws-bundle-1.10.0.jar \
        ${MAVEN}/org/apache/iceberg/iceberg-aws-bundle/1.10.0/iceberg-aws-bundle-1.10.0.jar \
    && curl -fsSL -o /opt/spark/jars/hadoop-aws-3.4.1.jar \
        ${MAVEN}/org/apache/hadoop/hadoop-aws/3.4.1/hadoop-aws-3.4.1.jar \
    && curl -fsSL -o /opt/spark/jars/aws-java-sdk-bundle-2.24.6.jar \
        ${MAVEN}/software/amazon/awssdk/bundle/2.24.6/bundle-2.24.6.jar \
    && curl -fsSL -o /opt/spark/jars/wildfly-openssl-1.1.3.Final.jar \
        ${MAVEN}/org/wildfly/openssl/wildfly-openssl/1.1.3.Final/wildfly-openssl-1.1.3.Final.jar \
    && pip install --no-cache-dir pydantic sqlalchemy "psycopg[binary]" python-dotenv
USER spark
