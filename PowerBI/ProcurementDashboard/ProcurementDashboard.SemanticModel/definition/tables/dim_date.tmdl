	partition dim_date = m
		mode: import
		source =
				let
				    Source = ReadParquetTable("dim_date", {"date_key", "year", "quarter", "month", "day", "day_of_week", "is_weekend", "year_quarter", "year_month", "iso_year", "iso_week", "week_start_date"}),
				    Typed = Table.TransformColumnTypes(Source, {{"date_key", type date}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"month", Int64.Type}, {"day", Int64.Type}, {"day_of_week", Int64.Type}, {"is_weekend", type logical}, {"year_quarter", type text}, {"year_month", type text}, {"iso_year", Int64.Type}, {"iso_week", Int64.Type}, {"week_start_date", type date}}, "en-US"),
				    MonthOrder = Table.AddColumn(Typed, "year_month_order", each [year]*100+[month], Int64.Type),
				    QuarterOrder = Table.AddColumn(MonthOrder, "year_quarter_order", each [year]*10+[quarter], Int64.Type),
				    MonthStart = Table.AddColumn(QuarterOrder, "month_start", each Date.StartOfMonth([date_key]), type date)
				in
				    MonthStart

