	partition dim_party = m
		mode: import
		source =
				let
				    Source = ReadParquetTable("dim_party", {"party_key", "party_kind", "party_code", "party_name", "tax_code", "source_namespace"}),
				    Typed = Table.TransformColumnTypes(Source, {{"party_key", type text}, {"party_kind", type text}, {"party_code", type text}, {"party_name", type text}, {"tax_code", type text}, {"source_namespace", type text}}, "en-US"),
				    Display = Table.AddColumn(Typed,"party_display",each (if [party_name] = null or Text.Trim([party_name]) = "" then "Chưa có tên" else [party_name]) & " [" & [party_key] & "]",type text)
				in
				    Display

