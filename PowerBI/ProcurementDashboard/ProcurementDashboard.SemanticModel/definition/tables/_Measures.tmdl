table _Measures
	lineageTag: 03652dbd-b1d9-5b6d-a37e-49e4eba27af6

	/// Tổng fact_demand_daily[package_count] trong phạm vi chọn; không phải số dòng tổng hợp.
	measure 'Số gói kế hoạch' = SUM(fact_demand_daily[package_count])
		formatString: #,0
		displayFolder: Số lượng
		lineageTag: 08413c7f-49ed-5728-9a72-5464a72f7ad0

	/// Tổng fact_demand_daily[eligible_amount_count] trong phạm vi chọn; không phải số dòng tổng hợp.
