	/// Tổng fact_award_daily[eligible_amount_count] trong phạm vi chọn; không phải số dòng tổng hợp.
	measure 'Mẫu giá trúng' = SUM(fact_award_daily[eligible_amount_count])
		formatString: #,0
		displayFolder: Số lượng
		lineageTag: a09c0a4a-1a68-577d-b472-fd1b0f9a27b5

	/// Tổng fact_savings_daily[descriptive_sample_count] trong phạm vi chọn; không phải số dòng tổng hợp.
	measure 'Mẫu mô tả' = SUM(fact_savings_daily[descriptive_sample_count])
		formatString: #,0
		displayFolder: Số lượng
		lineageTag: fe66ee25-6c87-5fe6-8c6f-1c6ccfab0b99

	/// Tổng fact_savings_daily[scope_count] trong phạm vi chọn; không phải số dòng tổng hợp.
	measure 'Phạm vi so sánh' = SUM(fact_savings_daily[scope_count])
		formatString: #,0
		displayFolder: Số lượng
		lineageTag: 0484d740-cdcf-5d0c-a5f2-c5bff82ab64f

	/// Tổng fact_savings_daily[verified_sample_count] trong phạm vi chọn; không phải số dòng tổng hợp.
	measure 'Mẫu xác minh' = SUM(fact_savings_daily[verified_sample_count])
		formatString: #,0
		displayFolder: Số lượng
		lineageTag: a719de47-4f1a-51b9-bc95-115e9e1602a5

	/// Tổng fact_savings_daily[contract_sample_count] trong phạm vi chọn; không phải số dòng tổng hợp.
	measure 'Mẫu hợp đồng' = SUM(fact_savings_daily[contract_sample_count])
		formatString: #,0
		displayFolder: Số lượng
		lineageTag: 1b09b67e-4965-5de0-8be4-f21b8ded9e4f

	/// Tổng fact_bidding_competition_daily[opening_count] trong phạm vi chọn; không phải số dòng tổng hợp.
	measure 'Lượt mở thầu' = SUM(fact_bidding_competition_daily[opening_count])
		formatString: #,0
		displayFolder: Số lượng
		lineageTag: ae1ea41f-784e-5e19-bf9e-c4759cf9b5fd

	/// Tổng fact_bidding_competition_daily[total_bidders] trong phạm vi chọn; không phải số dòng tổng hợp.
	measure 'Lượt nhà thầu' = SUM(fact_bidding_competition_daily[total_bidders])
		formatString: #,0
		displayFolder: Số lượng
		lineageTag: 2a09d08d-0eba-50b2-8cb8-70fafe1b023d

	/// Tổng fact_bidding_competition_daily[single_bidder_count] trong phạm vi chọn; không phải số dòng tổng hợp.
	measure 'Lượt một nhà thầu' = SUM(fact_bidding_competition_daily[single_bidder_count])
		formatString: #,0
		displayFolder: Số lượng
		lineageTag: f4fb63d9-74f0-5d95-920d-5eb20a1bf4c1

	/// Tổng fact_bidding_competition_daily[multi_bidder_count] trong phạm vi chọn; không phải số dòng tổng hợp.
	measure 'Lượt nhiều nhà thầu' = SUM(fact_bidding_competition_daily[multi_bidder_count])
		formatString: #,0
		displayFolder: Số lượng
		lineageTag: a61cbe73-207e-5bda-90eb-c078d01b6f94

	/// Tổng fact_notice_daily[notice_count] trong phạm vi chọn; không phải số dòng tổng hợp.
	measure 'Thông báo' = SUM(fact_notice_daily[notice_count])
		formatString: #,0
		displayFolder: Số lượng
		lineageTag: eec9e75f-ab3d-5145-9b43-083e2084d5e2

	/// Tổng fact_notice_daily[cancelled_notice_count] trong phạm vi chọn; không phải số dòng tổng hợp.
	measure 'Thông báo hủy quan sát' = SUM(fact_notice_daily[cancelled_notice_count])
		formatString: #,0
		displayFolder: Số lượng
		lineageTag: 42e9e131-f669-5648-a0ec-68675c2c6af0

	/// Tổng theo trạng thái tại ngày cuối có bản ghi trong phạm vi tháng và lĩnh vực đang chọn.
	measure 'Gói theo trạng thái quan sát' = VAR lastDay=CALCULATE(MAX(fact_status_daily[report_date]), REMOVEFILTERS(dim_progress_status)) RETURN IF(NOT ISBLANK(lastDay), CALCULATE(SUM(fact_status_daily[package_count]), KEEPFILTERS(fact_status_daily[report_date]=lastDay)))
		formatString: #,0
		displayFolder: Số lượng
		lineageTag: f98906b0-1017-5d27-8f74-4146dcddaedf

	/// fact_demand_daily[planned_amount_sum]; chỉ VND, không quy đổi ngoại tệ. Chỉ hiển thị khi eligible_amount_count>0.
	measure 'Kế hoạch VND' = CALCULATE(IF(SUM(fact_demand_daily[eligible_amount_count]) > 0, SUM(fact_demand_daily[planned_amount_sum])), KEEPFILTERS(dim_currency[currency_code] = "VND"))
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Giá trị
		lineageTag: efc05355-fe3b-516b-ae5b-85f2beb36a3e

	/// Kế hoạch · tỷ VND
	measure 'Kế hoạch · tỷ VND' = DIVIDE([Kế hoạch VND], 1000000000)
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Giá trị
		lineageTag: 9afc9983-2de6-5099-b9cc-b8c618ecd9ee

	/// fact_award_daily[award_amount_sum]; chỉ VND, không quy đổi ngoại tệ. Chỉ hiển thị khi eligible_amount_count>0.
	measure 'Trúng thầu VND' = CALCULATE(IF(SUM(fact_award_daily[eligible_amount_count]) > 0, SUM(fact_award_daily[award_amount_sum])), KEEPFILTERS(dim_currency[currency_code] = "VND"))
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Giá trị
		lineageTag: 13601d75-219b-59a6-9bb4-900949ace42c

	/// Trúng thầu · tỷ VND
	measure 'Trúng thầu · tỷ VND' = DIVIDE([Trúng thầu VND], 1000000000)
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Giá trị
		lineageTag: dc44d97c-3a64-5bb7-8a82-b871d1de7719

	/// fact_savings_daily[descriptive_baseline_sum]; chỉ VND, không quy đổi ngoại tệ. Chỉ hiển thị khi descriptive_sample_count>0.
	measure 'Dự toán mô tả VND' = CALCULATE(IF(SUM(fact_savings_daily[descriptive_sample_count]) > 0, SUM(fact_savings_daily[descriptive_baseline_sum])), KEEPFILTERS(dim_currency[currency_code] = "VND"))
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Giá trị
		lineageTag: 7bcee517-e5be-51bd-a334-2dd8d1bf4b82

	/// Dự toán mô tả · tỷ VND
	measure 'Dự toán mô tả · tỷ VND' = DIVIDE([Dự toán mô tả VND], 1000000000)
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Giá trị
		lineageTag: cb3e92c1-7ff8-5af4-9f57-d8dfc4c4896c

	/// fact_savings_daily[descriptive_award_sum]; chỉ VND, không quy đổi ngoại tệ. Chỉ hiển thị khi descriptive_sample_count>0.
	measure 'Giá trúng mô tả VND' = CALCULATE(IF(SUM(fact_savings_daily[descriptive_sample_count]) > 0, SUM(fact_savings_daily[descriptive_award_sum])), KEEPFILTERS(dim_currency[currency_code] = "VND"))
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Giá trị
		lineageTag: 7e963f7e-e757-5c77-96fd-5689b98b66bf

	/// Giá trúng mô tả · tỷ VND
	measure 'Giá trúng mô tả · tỷ VND' = DIVIDE([Giá trúng mô tả VND], 1000000000)
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Giá trị
		lineageTag: 48dee3e3-bb27-5f81-aa41-670236b2d6e0

	/// fact_savings_daily[descriptive_difference_sum]; chỉ VND, không quy đổi ngoại tệ. Chỉ hiển thị khi descriptive_sample_count>0.
	measure 'Chênh lệch mô tả VND' = CALCULATE(IF(SUM(fact_savings_daily[descriptive_sample_count]) > 0, SUM(fact_savings_daily[descriptive_difference_sum])), KEEPFILTERS(dim_currency[currency_code] = "VND"))
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Giá trị
		lineageTag: 2280beaf-4dab-5b54-b35d-40c46b5180c9

	/// Chênh lệch mô tả · tỷ VND
	measure 'Chênh lệch mô tả · tỷ VND' = DIVIDE([Chênh lệch mô tả VND], 1000000000)
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Giá trị
		lineageTag: 3076adb2-1103-5db1-9f93-970c88f0287b

	/// Kế hoạch bình quân · tỷ VND
	measure 'Kế hoạch bình quân · tỷ VND' = DIVIDE([Kế hoạch · tỷ VND], [Mẫu giá kế hoạch])
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Tỷ lệ và bình quân
		lineageTag: 9d8450b5-6afa-57dc-8e76-210257aa1b02

	/// Độ phủ giá trúng
	measure 'Độ phủ giá trúng' = DIVIDE([Mẫu giá trúng], [Lượt kết quả hiệu lực])
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Tỷ lệ và bình quân
		lineageTag: 12b5fee3-e3a3-5e92-abd3-076036869f72

	/// Tỷ lệ chênh lệch mô tả
	measure 'Tỷ lệ chênh lệch mô tả' = DIVIDE([Chênh lệch mô tả VND], [Dự toán mô tả VND])
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Tỷ lệ và bình quân
		lineageTag: 062d005f-f9d4-5582-9485-00493ce18322

	/// Độ phủ mẫu mô tả
	measure 'Độ phủ mẫu mô tả' = DIVIDE([Mẫu mô tả], [Phạm vi so sánh])
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Tỷ lệ và bình quân
		lineageTag: d63644a8-0008-5ff1-b25d-89e1c7032e13

	/// Nhà thầu bình quân
	measure 'Nhà thầu bình quân' = DIVIDE([Lượt nhà thầu], [Lượt mở thầu])
		formatString: 0.00
		displayFolder: Tỷ lệ và bình quân
		lineageTag: 4f2762a9-6180-537e-ab8a-e0ccf810f63b

	/// Tỷ lệ một nhà thầu
	measure 'Tỷ lệ một nhà thầu' = DIVIDE([Lượt một nhà thầu], [Lượt mở thầu])
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Tỷ lệ và bình quân
		lineageTag: e849a4a8-2112-55c6-8db0-200e493b26cc

	/// Tỷ lệ nhiều nhà thầu
	measure 'Tỷ lệ nhiều nhà thầu' = DIVIDE([Lượt nhiều nhà thầu], [Lượt mở thầu])
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Tỷ lệ và bình quân
		lineageTag: efc85048-98f3-525a-b3c3-0dca7d755f06

	/// Tỷ lệ hủy quan sát
	measure 'Tỷ lệ hủy quan sát' = DIVIDE([Thông báo hủy quan sát], [Thông báo])
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Tỷ lệ và bình quân
		lineageTag: 5d565e2d-4363-52ce-8c74-f13528a368a2

	/// Mẫu thời gian
	measure 'Mẫu thời gian' = IF(HASONEVALUE(dim_duration_metric[metric_key]), SUM(fact_duration_daily[sample_count]))
		formatString: #,0
		displayFolder: Thời gian
		lineageTag: c071fca9-7984-5277-be1b-1b5edf2d2460

	/// Mẫu thời gian bị loại
	measure 'Mẫu thời gian bị loại' = IF(HASONEVALUE(dim_duration_metric[metric_key]), SUM(fact_duration_daily[excluded_sample_count]))
		formatString: #,0
		displayFolder: Thời gian
		lineageTag: bc4b0e14-61e6-5a3d-bd2b-1fc3e47ef134

	/// Khoảng thời gian
	measure 'Khoảng thời gian' = IF(HASONEVALUE(dim_duration_metric[metric_key]), SUM(fact_duration_daily[interval_count]))
		formatString: #,0
		displayFolder: Thời gian
		lineageTag: 3467d941-ddea-54c0-92fb-c7cbc8d36d31

	/// Thời gian bình quân
	measure 'Thời gian bình quân' = IF(HASONEVALUE(dim_duration_metric[metric_key]), DIVIDE(SUM(fact_duration_daily[duration_sum]), [Mẫu thời gian]))
		displayFolder: Thời gian
		lineageTag: 95d888db-1ba4-5cee-b6a1-b65de346d612

		formatStringDefinition = IF(SELECTEDVALUE(dim_duration_metric[duration_unit]) = "hours", "0.0 ""giờ""", "0.0 ""ngày""")

	/// Tỷ lệ mẫu bị loại
	measure 'Tỷ lệ mẫu bị loại' = DIVIDE([Mẫu thời gian bị loại], [Khoảng thời gian])
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Thời gian
		lineageTag: f7396c37-c51d-5de2-a780-899957c7a018

	/// Đơn vị thời gian
	measure 'Đơn vị thời gian' = SWITCH(SELECTEDVALUE(dim_duration_metric[duration_unit]), "hours", "giờ", "days", "ngày", BLANK())
		displayFolder: Thời gian
		lineageTag: 82c0bfc5-5b15-50e7-a8ac-3c3cabc9dc49

	/// Người nhận · tỷ VND
	measure 'Người nhận · tỷ VND' = CALCULATE(IF(SUM(fact_supplier_daily[eligible_amount_count])>0, DIVIDE(SUM(fact_supplier_daily[award_amount_sum]),1000000000)), KEEPFILTERS(fact_supplier_daily[recipient_allocation_state]="single_recipient"), KEEPFILTERS(fact_supplier_daily[eligible_amount_count]>0), KEEPFILTERS(dim_party[party_kind]<>"UNKNOWN"), KEEPFILTERS(dim_currency[currency_code]="VND"))
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Người nhận
		lineageTag: 4fbc9ed8-e7ca-5dc4-8b99-f71b74674431

	/// Số khóa người nhận
	measure 'Số khóa người nhận' = CALCULATE(DISTINCTCOUNT(fact_supplier_daily[party_key]), KEEPFILTERS(fact_supplier_daily[recipient_allocation_state]="single_recipient"), KEEPFILTERS(fact_supplier_daily[eligible_amount_count]>0), KEEPFILTERS(dim_party[party_kind]<>"UNKNOWN"), KEEPFILTERS(dim_currency[currency_code]="VND"))
		formatString: #,0
		displayFolder: Người nhận
		lineageTag: 8fd8dd8c-ad43-5f8f-9429-9335a6055ea6

	/// Phân bổ · tỷ VND
	measure 'Phân bổ · tỷ VND' = CALCULATE(IF(SUM(fact_supplier_daily[eligible_amount_count])>0, DIVIDE(SUM(fact_supplier_daily[award_amount_sum]),1000000000)), KEEPFILTERS(dim_currency[currency_code]="VND"))
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Người nhận
		lineageTag: 341bcfc4-4c75-5b05-82c2-885f8bf39e57

	/// Phân bổ · số lượt
	measure 'Phân bổ · số lượt' = SUM(fact_supplier_daily[award_scope_count])
		formatString: #,0
		displayFolder: Người nhận
		lineageTag: dfcf64f9-3b9d-58e2-befe-abf824df5b11

	/// Tỷ trọng Top 10 người nhận
	measure 'Tỷ trọng Top 10 người nhận' = CALCULATE(         VAR People = CALCULATETABLE(VALUES(fact_supplier_daily[party_key]), KEEPFILTERS(fact_supplier_daily[recipient_allocation_state]="single_recipient"), KEEPFILTERS(fact_supplier_daily[eligible_amount_count]>0), KEEPFILTERS(dim_party[party_kind]<>"UNKNOWN"), KEEPFILTERS(dim_currency[currency_code]="VND"))         VAR Amounts = FILTER(ADDCOLUMNS(People, "_value", [Người nhận · tỷ VND]), NOT ISBLANK([_value]))         VAR Ranked = TOPN(10, Amounts, [_value], DESC, fact_supplier_daily[party_key], ASC)         RETURN DIVIDE(SUMX(Ranked, [_value]), [Người nhận · tỷ VND]), ALLSELECTED(dim_party))
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Người nhận
		lineageTag: a056869c-b34c-59e6-8749-f588e4f14ad2

	/// Nhóm kỹ thuật cần xác minh
	measure 'Nhóm kỹ thuật cần xác minh' = COUNTROWS(FILTER(fact_bidding_competition_daily, fact_bidding_competition_daily[tech_passed_count]+fact_bidding_competition_daily[tech_failed_count]>fact_bidding_competition_daily[total_bidders]))
		formatString: #,0
		displayFolder: Chất lượng
		lineageTag: 6069c7d4-6b7e-59d5-8af2-3c678dd558d5

	/// Số nhóm lệch trên 0,01 đơn vị tiền nguồn sau chuyển double; không phải chênh lệch đã quy đổi VND.
	measure 'Nhóm tiền dự thầu lệch' = COUNTROWS(FILTER(fact_bidding_competition_daily, ABS(fact_bidding_competition_daily[total_bid_amount]-fact_bidding_competition_daily[total_discount_amount]-fact_bidding_competition_daily[total_final_bid_amount])>0.01))
		formatString: #,0
		displayFolder: Chất lượng
		lineageTag: d871784b-2373-51c9-bf59-e6404a0e9384

	/// Phạm vi cạnh tranh
	measure 'Phạm vi cạnh tranh' = VAR a=MIN(fact_bidding_competition_daily[report_date]) VAR z=MAX(fact_bidding_competition_daily[report_date]) RETURN IF(ISBLANK(a), "Không có dữ liệu trong phạm vi chọn", "Quan sát: " & FORMAT(a,"dd/MM/yyyy") & " – " & FORMAT(z,"dd/MM/yyyy"))
		displayFolder: Chất lượng
		lineageTag: 024db8c7-e0d2-5ebd-81a6-c36df014ea57

	/// Số nhóm tổng hợp có bản ghi; không chứng minh độ đầy đủ thu thập.
	measure 'Dòng · demand' = COUNTROWS(fact_demand_daily)
		formatString: #,0
		displayFolder: Độ phủ
		lineageTag: a49ad59d-c232-5836-96b4-ce17edb43cd1

	/// Số nhóm tổng hợp có bản ghi; không chứng minh độ đầy đủ thu thập.
	measure 'Dòng · award' = COUNTROWS(fact_award_daily)
		formatString: #,0
		displayFolder: Độ phủ
		lineageTag: b47b08fc-7e22-53f5-acd1-4ce5eb4dec24

	/// Số nhóm tổng hợp có bản ghi; không chứng minh độ đầy đủ thu thập.
	measure 'Dòng · savings' = COUNTROWS(fact_savings_daily)
		formatString: #,0
		displayFolder: Độ phủ
		lineageTag: eb987e3d-6cbc-54c4-b86a-686cabe36ebd

	/// Số nhóm tổng hợp có bản ghi; không chứng minh độ đầy đủ thu thập.
	measure 'Dòng · bidding_competition' = COUNTROWS(fact_bidding_competition_daily)
		formatString: #,0
		displayFolder: Độ phủ
		lineageTag: 20c576f2-03e9-5279-8a8c-772a7fd4d2cf

	/// Số nhóm tổng hợp có bản ghi; không chứng minh độ đầy đủ thu thập.
	measure 'Dòng · duration' = COUNTROWS(fact_duration_daily)
		formatString: #,0
