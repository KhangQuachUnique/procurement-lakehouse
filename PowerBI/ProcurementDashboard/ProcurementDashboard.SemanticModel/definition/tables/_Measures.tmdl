		lineageTag: b4eeaf90-745c-50a8-8629-a9cefadad76a

	/// Mẫu giá trúng VND
	measure 'Mẫu giá trúng VND' = CALCULATE([Mẫu giá trúng], KEEPFILTERS(dim_currency[currency_code]="VND"))
		formatString: #,0
		displayFolder: Giá trị
		lineageTag: 1121bad1-773d-53ff-a1e1-c4a5db43b0fc

	/// Tỷ trọng gói VND
	measure 'Tỷ trọng gói VND' = CALCULATE(DIVIDE([Số gói kế hoạch], CALCULATE([Số gói kế hoạch], ALLSELECTED(dim_value_band[band_label], dim_value_band[band_order]))), KEEPFILTERS(dim_currency[currency_code]="VND"))
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Cơ cấu
		lineageTag: 05a138e8-1abf-5d70-8239-2aab2a4626c9

	/// Tỷ trọng giá kế hoạch VND
	measure 'Tỷ trọng giá kế hoạch VND' = CALCULATE(DIVIDE([Kế hoạch · tỷ VND], CALCULATE([Kế hoạch · tỷ VND], ALLSELECTED(dim_value_band[band_label], dim_value_band[band_order]))), KEEPFILTERS(dim_currency[currency_code]="VND"))
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Cơ cấu
		lineageTag: 868126c5-aec6-5737-ba89-333edde3dc73

	/// Chênh so với tập chọn · đpt
	measure 'Chênh so với tập chọn · đpt' = VAR r=[Tỷ lệ một nhà thầu] VAR refRate=CALCULATE([Tỷ lệ một nhà thầu], ALLSELECTED(dim_sector[sector_name])) RETURN IF(NOT ISBLANK(r) && NOT ISBLANK(refRate), (r-refRate)*100)
		formatString: 0.0
		displayFolder: Cạnh tranh
		lineageTag: 306894b6-38a3-52f1-b68f-4844303e0f28

	/// Mẫu giá người nhận
	measure 'Mẫu giá người nhận' = CALCULATE(SUM(fact_supplier_daily[eligible_amount_count]), KEEPFILTERS(fact_supplier_daily[recipient_allocation_state]="single_recipient"), KEEPFILTERS(fact_supplier_daily[eligible_amount_count]>0), KEEPFILTERS(dim_party[party_kind]<>"UNKNOWN"), KEEPFILTERS(dim_currency[currency_code]="VND"))
		formatString: #,0
		displayFolder: Người nhận
		lineageTag: 9073a563-1b4d-5222-9615-aca36ddb37e0

	/// Độ phủ giá trị người nhận
	measure 'Độ phủ giá trị người nhận' = DIVIDE([Người nhận · tỷ VND], [Phân bổ · tỷ VND])
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Người nhận
		lineageTag: 66bb9283-25ff-57d6-8273-263ae1c02913

	/// Hiển thị · Mẫu giá trúng VND
	measure 'Hiển thị · Mẫu giá trúng VND' = IF(ISBLANK([Mẫu giá trúng VND]), "—", FORMAT([Mẫu giá trúng VND], "#,0", "vi-VN"))
		displayFolder: Hiển thị
		lineageTag: ed12339d-5fba-516c-9569-cc6a3d0e1a9b

	/// Hiển thị · Tỷ trọng gói VND
	measure 'Hiển thị · Tỷ trọng gói VND' = IF(ISBLANK([Tỷ trọng gói VND]), "—", FORMAT([Tỷ trọng gói VND], "0.00%;(0.00%);0.00%", "vi-VN"))
		displayFolder: Hiển thị
		lineageTag: 8faf9b38-4999-5ba2-a7ff-948363b93870

	/// Hiển thị · Tỷ trọng giá kế hoạch VND
	measure 'Hiển thị · Tỷ trọng giá kế hoạch VND' = IF(ISBLANK([Tỷ trọng giá kế hoạch VND]), "—", FORMAT([Tỷ trọng giá kế hoạch VND], "0.00%;(0.00%);0.00%", "vi-VN"))
		displayFolder: Hiển thị
		lineageTag: cc0fe00a-1f92-5a44-af57-85516b952bb9

	/// Hiển thị · Chênh so với tập chọn · đpt
	measure 'Hiển thị · Chênh so với tập chọn · đpt' = IF(ISBLANK([Chênh so với tập chọn · đpt]), "—", FORMAT([Chênh so với tập chọn · đpt], "0.0", "vi-VN"))
		displayFolder: Hiển thị
		lineageTag: 4a1486bb-5560-5b66-bca1-9b946daa0c61

	/// Hiển thị · Mẫu giá người nhận
	measure 'Hiển thị · Mẫu giá người nhận' = IF(ISBLANK([Mẫu giá người nhận]), "—", FORMAT([Mẫu giá người nhận], "#,0", "vi-VN"))
		displayFolder: Hiển thị
		lineageTag: b707f2d6-8e51-5b48-828b-4878e9e743aa

	/// Hiển thị · Độ phủ giá trị người nhận
	measure 'Hiển thị · Độ phủ giá trị người nhận' = IF(ISBLANK([Độ phủ giá trị người nhận]), "—", FORMAT([Độ phủ giá trị người nhận], "0.00%;(0.00%);0.00%", "vi-VN"))
		displayFolder: Hiển thị
		lineageTag: 68b47366-369f-57ea-a0fb-412912e82807

	/// Luồng có quan sát
	measure 'Luồng có quan sát' = VAR streams=FILTER({IF([Dòng · demand] > 0, "Kế hoạch"), IF([Dòng · award] > 0, "Kết quả"), IF([Dòng · savings] > 0, "So sánh giá"), IF([Dòng · bidding_competition] > 0, "Mở thầu"), IF([Dòng · duration] > 0, "Thời gian"), IF([Dòng · supplier] > 0, "Người nhận"), IF([Dòng · notice] > 0, "Thông báo"), IF([Dòng · status] > 0, "Trạng thái")}, NOT ISBLANK([Value])) RETURN IF(COUNTROWS(streams)>0, CONCATENATEX(streams,[Value],", ",[Value],ASC))
		displayFolder: Độ phủ
		lineageTag: 21cb00e8-6f8d-5da0-922f-34e6e14f2972

	/// Đối sánh tập chọn
	measure 'Đối sánh tập chọn' = CALCULATE([Tỷ lệ một nhà thầu], ALLSELECTED(dim_sector[sector_name]))
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Cạnh tranh
		lineageTag: f2d52695-6c98-5672-95b5-67918f9723dd

	/// Màu cạnh tranh
	measure 'Màu cạnh tranh' = VAR r=[Tỷ lệ một nhà thầu] RETURN IF(NOT ISBLANK(r), SWITCH(TRUE(), r<0.25,"#EFF5FC", r<0.5,"#D5E6FA", r<0.75,"#A8CDF5","#76A8E0"))
		displayFolder: Cạnh tranh
		lineageTag: 9e1ed731-a506-5234-bb95-1b68ccd510de

	/// Lưu ý cỡ mẫu
	measure 'Lưu ý cỡ mẫu' = IF([Lượt mở thầu]>0 && [Lượt mở thầu]<30, "Ít hơn 30 lượt mở")
		displayFolder: Cạnh tranh
		lineageTag: 39ef88db-a261-5bed-89e8-b8e1c81b7715

	/// Mẫu ngoài so sánh
	measure 'Mẫu ngoài so sánh' = IF(NOT ISBLANK([Phạm vi so sánh]) && NOT ISBLANK([Mẫu mô tả]), [Phạm vi so sánh]-[Mẫu mô tả])
		formatString: #,0
		displayFolder: Chất lượng
		lineageTag: 82d5dcd7-7bed-5c41-bbf1-b067d0eace5a

	/// Khóa người nhận
	measure 'Khóa người nhận' = SELECTEDVALUE(dim_party[party_key])
		displayFolder: Người nhận
		lineageTag: ebc9ba51-4bee-5989-84ee-947350c7a556

	/// Giá trúng thiếu địa phương
	measure 'Giá trúng thiếu địa phương' = CALCULATE([Trúng thầu · tỷ VND], KEEPFILTERS(dim_geography[geography_key] IN {"GEO_UNKNOWN","GEO_MULTI_UNALLOCATED"}))
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Chất lượng
		lineageTag: 4ee93aa8-cf97-5f19-bc1d-c9d5f6eefe6f

	/// Giá chưa phân bổ
	measure 'Giá chưa phân bổ' = CALCULATE([Phân bổ · tỷ VND], KEEPFILTERS(fact_supplier_daily[recipient_allocation_state]<>"single_recipient"))
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Chất lượng
		lineageTag: e0e867ac-d37d-502f-9291-181c3ac217d8

	/// Hiển thị · Đối sánh tập chọn
	measure 'Hiển thị · Đối sánh tập chọn' = IF(ISBLANK([Đối sánh tập chọn]), "—", FORMAT([Đối sánh tập chọn], "0.00%;(0.00%);0.00%", "vi-VN"))
		displayFolder: Hiển thị
		lineageTag: fe76246c-9c38-5a45-9cd5-34c70cc088c2

	/// Hiển thị · Mẫu ngoài so sánh
	measure 'Hiển thị · Mẫu ngoài so sánh' = IF(ISBLANK([Mẫu ngoài so sánh]), "—", FORMAT([Mẫu ngoài so sánh], "#,0", "vi-VN"))
		displayFolder: Hiển thị
		lineageTag: a40bc631-6e9c-5c3b-95ad-d3a5dca728a4

	/// Hiển thị · Giá trúng thiếu địa phương
	measure 'Hiển thị · Giá trúng thiếu địa phương' = IF(ISBLANK([Giá trúng thiếu địa phương]), "—", FORMAT([Giá trúng thiếu địa phương], "#,0.00;(#,0.00);0.00", "vi-VN"))
		displayFolder: Hiển thị
		lineageTag: d4f3e575-6033-5297-b65e-9996993b317b

	/// Hiển thị · Giá chưa phân bổ
	measure 'Hiển thị · Giá chưa phân bổ' = IF(ISBLANK([Giá chưa phân bổ]), "—", FORMAT([Giá chưa phân bổ], "#,0.00;(#,0.00);0.00", "vi-VN"))
		displayFolder: Hiển thị
		lineageTag: c755834a-0e97-5d49-a9ee-1749f3b3e401

	/// Số gói nhóm từ 100 tỷ
	measure 'Số gói nhóm từ 100 tỷ' = CALCULATE(DIVIDE(CALCULATE([Số gói kế hoạch], KEEPFILTERS(dim_value_band[band_label]="Từ 100 tỷ VND trở lên")), [Số gói kế hoạch]), KEEPFILTERS(dim_currency[currency_code]="VND"))
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Phân tích
		lineageTag: 793da805-3d08-5aa6-9359-0a1761609936

	/// Giá trị nhóm từ 100 tỷ
	measure 'Giá trị nhóm từ 100 tỷ' = CALCULATE(DIVIDE(CALCULATE([Kế hoạch · tỷ VND], KEEPFILTERS(dim_value_band[band_label]="Từ 100 tỷ VND trở lên")), [Kế hoạch · tỷ VND]), KEEPFILTERS(dim_currency[currency_code]="VND"))
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: Phân tích
		lineageTag: bfaf25fe-4fe5-5c38-9396-13b00e42fcef

	/// Biên độ cạnh tranh
	measure 'Biên độ cạnh tranh' = VAR sectors=FILTER(ALLSELECTED(dim_sector[sector_name]), [Lượt mở thầu]>=30) RETURN IF(COUNTROWS(sectors)>1, (MAXX(sectors,[Tỷ lệ một nhà thầu])-MINX(sectors,[Tỷ lệ một nhà thầu]))*100)
		formatString: 0.0
		displayFolder: Phân tích
		lineageTag: 10f3570f-426b-53ae-afe3-c3d4ac7b661c

	/// Nền Dòng · demand
	measure 'Nền Dòng · demand' = IF(NOT ISBLANK([Dòng · demand]), "#DCEAFE", "#F5F6F8")
		displayFolder: Phân tích
		lineageTag: e2623cd7-b4b9-5c73-b558-c4c57aa05332

	/// Nền Dòng · award
	measure 'Nền Dòng · award' = IF(NOT ISBLANK([Dòng · award]), "#DCEAFE", "#F5F6F8")
		displayFolder: Phân tích
		lineageTag: e32cb18b-902d-50de-bfbb-d90ec2910ea9

	/// Nền Dòng · savings
	measure 'Nền Dòng · savings' = IF(NOT ISBLANK([Dòng · savings]), "#DCEAFE", "#F5F6F8")
		displayFolder: Phân tích
		lineageTag: 69036314-8f43-55ff-ba79-35c3c19cf6b5

	/// Nền Dòng · bidding_competition
	measure 'Nền Dòng · bidding_competition' = IF(NOT ISBLANK([Dòng · bidding_competition]), "#DCEAFE", "#F5F6F8")
		displayFolder: Phân tích
		lineageTag: 093015e2-a013-5690-8047-e490d05e1fe6

	/// Nền Dòng · duration
	measure 'Nền Dòng · duration' = IF(NOT ISBLANK([Dòng · duration]), "#DCEAFE", "#F5F6F8")
		displayFolder: Phân tích
		lineageTag: 0f6d429a-faff-57fe-9c63-824f0e85835a

	/// Nền Dòng · supplier
	measure 'Nền Dòng · supplier' = IF(NOT ISBLANK([Dòng · supplier]), "#DCEAFE", "#F5F6F8")
		displayFolder: Phân tích
		lineageTag: 9fc6e961-cd7b-59db-9856-4bff62378799

	/// Nền Dòng · notice
	measure 'Nền Dòng · notice' = IF(NOT ISBLANK([Dòng · notice]), "#DCEAFE", "#F5F6F8")
		displayFolder: Phân tích
		lineageTag: b956db0f-cb8b-5d80-bbc6-70031a22f2f9

	/// Nền Dòng · status
	measure 'Nền Dòng · status' = IF(NOT ISBLANK([Dòng · status]), "#DCEAFE", "#F5F6F8")
		displayFolder: Phân tích
		lineageTag: 0c6ef197-80bd-51da-b0af-c6a36a541aeb

	/// Tên người nhận
	measure 'Tên người nhận' = SELECTEDVALUE(dim_party[party_name])
		displayFolder: Hiển thị
		lineageTag: d80b1e0d-a08b-5d9b-b6d2-8fca6c39185d

	/// Hạng người nhận
	measure 'Hạng người nhận' = VAR k=SELECTEDVALUE(dim_party[party_key]) VAR v=[Người nhận · tỷ VND] VAR candidates=CALCULATETABLE(VALUES(dim_party[party_key]),ALLSELECTED(dim_party[party_key])) VAR ranked=ADDCOLUMNS(candidates,"_amount",CALCULATE([Người nhận · tỷ VND])) RETURN IF(ISINSCOPE(dim_party[party_key]) && NOT ISBLANK(v),1+COUNTROWS(FILTER(ranked,[_amount]>v || ([_amount]=v && dim_party[party_key]<k))))
		displayFolder: Hiển thị
		lineageTag: 93a0f55f-26e5-524d-894d-b19e5ab965ad

	/// Tiêu đề thời gian trend
	measure 'Tiêu đề thời gian trend' = "Bình quân theo tháng" & IF(NOT ISBLANK([Đơn vị thời gian]), " · " & [Đơn vị thời gian])
		displayFolder: Hiển thị
		lineageTag: 15de8651-8990-579c-8ffa-cade8246e96c

	/// Tiêu đề thời gian sectors
	measure 'Tiêu đề thời gian sectors' = "Bình quân theo lĩnh vực" & IF(NOT ISBLANK([Đơn vị thời gian]), " · " & [Đơn vị thời gian])
		displayFolder: Hiển thị
		lineageTag: 58893972-31b8-57f9-b4e4-0d91d99f045d

	/// Tiêu đề thời gian methods
	measure 'Tiêu đề thời gian methods' = "Bình quân theo phương thức" & IF(NOT ISBLANK([Đơn vị thời gian]), " · " & [Đơn vị thời gian])
		displayFolder: Hiển thị
		lineageTag: 279005cd-57bd-582e-a614-792e97dac7cf

	/// Tiêu đề cơ cấu lĩnh vực
	measure 'Tiêu đề cơ cấu lĩnh vực' = VAR v=[Trúng thầu · tỷ VND] RETURN "Giá trúng theo lĩnh vực" & IF(NOT ISBLANK(v), " · " & FORMAT(v/1000,"#,0.0","vi-VN") & " nghìn tỷ VND")
		displayFolder: Hiển thị
		lineageTag: 692ccbd5-80a2-502b-a422-eb7f5fa3db75

	/// Hiển thị · Số gói nhóm từ 100 tỷ
	measure 'Hiển thị · Số gói nhóm từ 100 tỷ' = IF(ISBLANK([Số gói nhóm từ 100 tỷ]), "—", FORMAT([Số gói nhóm từ 100 tỷ], "0.00%;(0.00%);0.00%", "vi-VN"))
		displayFolder: Hiển thị
		lineageTag: d18eb92c-9c86-53b6-b152-3463eddf276e

	/// Hiển thị · Giá trị nhóm từ 100 tỷ
	measure 'Hiển thị · Giá trị nhóm từ 100 tỷ' = IF(ISBLANK([Giá trị nhóm từ 100 tỷ]), "—", FORMAT([Giá trị nhóm từ 100 tỷ], "0.00%;(0.00%);0.00%", "vi-VN"))
		displayFolder: Hiển thị
		lineageTag: d5e3bae9-4b8d-510e-b5e8-dd04e8bf5fe7

	/// Hiển thị · Biên độ cạnh tranh
	measure 'Hiển thị · Biên độ cạnh tranh' = IF(ISBLANK([Biên độ cạnh tranh]), "—", FORMAT([Biên độ cạnh tranh], "0.0", "vi-VN"))
		displayFolder: Hiển thị
		lineageTag: c83c03e4-d5f4-56db-9110-c37cc93976a2

	column _placeholder
		dataType: int64
		isHidden
		lineageTag: 3bb065e5-3d64-4a4f-9b41-22a4c35ef528
		sourceColumn: _placeholder

	partition _Measures = m
		mode: import
		source = #table(type table [_placeholder = Int64.Type], {{0}})

