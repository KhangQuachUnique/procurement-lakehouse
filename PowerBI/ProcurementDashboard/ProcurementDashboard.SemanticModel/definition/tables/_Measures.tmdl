	/// Nhãn trình bày từ party_kind, không thay đổi dữ liệu gốc.
	measure 'Loại đơn vị' = VAR v=SELECTEDVALUE(dim_party[party_kind]) RETURN SWITCH(v,"ORGANIZATION","Tổ chức","PERSON","Cá nhân","CONSORTIUM","Liên danh",v)
		displayFolder: Đơn vị
		lineageTag: 8ac50e87-2be5-5974-8287-ae5679489c4b

	/// Nhãn trình bày; bảng chỉ xét trạng thái single_recipient.
	measure 'Phân bổ đơn vị' = CALCULATE(SWITCH(SELECTEDVALUE(fact_supplier_daily[recipient_allocation_state]),"single_recipient","Nhận đơn",BLANK()), KEEPFILTERS(fact_supplier_daily[recipient_allocation_state]="single_recipient"))
		displayFolder: Đơn vị
		lineageTag: 6d90b0bd-e8d8-5bb1-9c07-208dfe38df5b

