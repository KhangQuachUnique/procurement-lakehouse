{
  "name": "Procurement Enterprise",
  "dataColors": [
    "#174EA6",
    "#4385E8",
    "#A8CDF5",
    "#D97706",
    "#719ED7",
    "#CBD5E1"
  ],
  "background": "#F5F6F8",
  "foreground": "#0F172A",
  "tableAccent": "#4385E8",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0F172A"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#64748B"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#174EA6"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "visualHeader": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#EAF1FF"
              }
            }
          }
        ],
        "values": [
          {
            "fontSize": 10
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontSize": 10
          }
        ],
        "rowHeaders": [
          {
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontSize": 10
          }
        ]
      }
    }
  }
}